[Unit]
Description=Personal Agent production web build watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ahmed/projects/personal-agent/server
Environment=PATH=/home/ahmed/.local/share/pi-node/current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ahmed/.local/share/pi-node/current/bin/node node_modules/vite/bin/vite.js build --watch --config web/vite.config.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
